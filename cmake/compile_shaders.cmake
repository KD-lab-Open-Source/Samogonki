# Compiles the SDL GPU renderer's HLSL to this platform's one shader format and embeds the
# results in a C++ header, as a <name>_code[] array per entry point. Adapted from
# VistaEngine's cmake/bin2h.cmake (github.com/KD-lab-Open-Source/VistaEngine).
#
#   Windows: DXIL   with the Windows SDK's dxc.exe (MODE dxc)
#   macOS:   MSL    with SDL_shadercross          (MODE shadercross)
#   Linux:   SPIR-V with SDL_shadercross          (MODE shadercross)
#
# Run at build time by the rule in MechoSoma/CMakeLists.txt:
#
#   cmake -DOUTPUT=<header> -DMODE=<dxc|shadercross> -DCOMPILER=<executable>
#         -DFORMAT=<DXIL|MSL|SPIRV> -DSOURCE_DIR=<the .hlsl> -DWORK_DIR=<intermediates>
#         -DSHADERS=<name>:<stage>|<name>:<stage>|... -P compile_shaders.cmake
#
# Each shader is <SOURCE_DIR>/<name>.hlsl with an entry point called main; <stage> is
# vertex or fragment. The list is separated by |, not ;, because CMake would split a
# ;-separated argument into several. Compiling and embedding are one script, so a
# parallel build can't embed a shader before it is compiled.

foreach (_variable OUTPUT MODE COMPILER FORMAT SOURCE_DIR WORK_DIR SHADERS)
    if (NOT ${_variable})
        message(FATAL_ERROR "compile_shaders.cmake: ${_variable} is not set")
    endif ()
endforeach ()

file(MAKE_DIRECTORY "${WORK_DIR}")

function(compile_shader NAME STAGE OUTPUT_FILE)
    set(_source "${SOURCE_DIR}/${NAME}.hlsl")
    if (MODE STREQUAL "dxc")
        # SDL GPU needs shader model 6.0 or newer.
        if (STAGE STREQUAL "vertex")
            set(_profile vs_6_0)
        elseif (STAGE STREQUAL "fragment")
            set(_profile ps_6_0)
        else ()
            message(FATAL_ERROR "compile_shaders.cmake: unknown stage ${STAGE} for ${NAME}")
        endif ()
        set(_command "${COMPILER}" -nologo -T ${_profile} -E main -I "${SOURCE_DIR}" -Fo "${OUTPUT_FILE}" "${_source}")
    elseif (MODE STREQUAL "shadercross")
        set(_command "${COMPILER}" "${_source}" -s HLSL -d ${FORMAT} -t ${STAGE} -e main -I "${SOURCE_DIR}"
            -o "${OUTPUT_FILE}")
    else ()
        message(FATAL_ERROR "compile_shaders.cmake: unknown MODE ${MODE}")
    endif ()

    execute_process(COMMAND ${_command}
        RESULT_VARIABLE _result OUTPUT_VARIABLE _output ERROR_VARIABLE _output)
    if (NOT _result EQUAL 0)
        message(FATAL_ERROR "Compiling ${NAME}.hlsl (${STAGE}) to ${FORMAT} failed (${_result}):\n${_output}")
    endif ()
endfunction()

string(TOLOWER "${FORMAT}" _extension)
set(_header "// Generated by cmake/compile_shaders.cmake from MechoSoma/app/sdl_gpu/shaders: ${FORMAT}.\n")
string(APPEND _header "// Do not edit.\n#pragma once\n")

string(REPLACE "|" ";" _shaders "${SHADERS}")
foreach (_shader IN LISTS _shaders)
    if (NOT _shader MATCHES "^([A-Za-z0-9_]+):(vertex|fragment)$")
        message(FATAL_ERROR "compile_shaders.cmake: '${_shader}' is not <name>:<vertex|fragment>")
    endif ()
    set(_name "${CMAKE_MATCH_1}")
    set(_compiled "${WORK_DIR}/${_name}.${_extension}")
    compile_shader(${_name} ${CMAKE_MATCH_2} "${_compiled}")

    # 16 bytes a line. (CMake's regular expressions have no {n}.)
    file(READ "${_compiled}" _hex HEX)
    string(REGEX REPLACE "(..)" "0x\\1," _bytes "${_hex}")
    string(REPEAT "0x..," 16 _line)
    string(REGEX REPLACE "(${_line})" "\\1\n" _bytes "${_bytes}")
    string(APPEND _header "\nstatic const unsigned char ${_name}_code[] = {\n${_bytes}\n};\n")
endforeach ()

file(WRITE "${OUTPUT}" "${_header}")
